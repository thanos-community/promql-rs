#!/bin/sh
# Reconstruct the promqltest pass count for every commit that changed it.
#
# No metric is collected anywhere: UNSUPPORTED.md is regenerated by
# PROMQL_PROMQLTEST_BLESS=1 and states the count in prose, and the allowlist
# ratchet fails CI until a changed pass set is re-blessed. So every commit
# already carries its own true count, and the series is a git walk rather than
# a database. That is what makes it backfillable -- a number collected by CI
# would only exist from the day CI started collecting it.
#
# Usage:
#   scripts/progress                 # series for HEAD
#   scripts/progress origin/main     # series for another ref
#   scripts/progress --json          # same, as JSON lines

set -eu

FILE=promql-conformance/testdata/prometheus/UNSUPPORTED.md
JSON=
REV=HEAD

for arg in "$@"; do
	case "$arg" in
	--json) JSON=1 ;;
	-h | --help)
		sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	*) REV=$arg ;;
	esac
done

# git log rather than rev-list, because only log implements --follow, and a
# rename of the roadmap should not truncate the series. Oldest first, so the
# output reads as a progression.
revs=$(git log --format=%H --reverse --follow "$REV" -- "$FILE")

if [ -z "$revs" ]; then
	echo "no commits touch $FILE in $REV" >&2
	exit 1
fi

[ -n "$JSON" ] || printf 'date\tcommit\tpassed\ttotal\tpercent\tdelta\n'

prev=
for sha in $revs; do
	counts=$(git show "$sha:$FILE" 2>/dev/null |
		sed -n 's/.*\*\*\([0-9]\{1,\}\) of \([0-9]\{1,\}\) evals pass\*\*.*/\1 \2/p' |
		head -1)

	# A commit that touched the file without the headline surviving is a bug in
	# the generator, not a gap to paper over silently.
	if [ -z "$counts" ]; then
		echo "warning: no pass count in $FILE at $sha" >&2
		continue
	fi

	passed=${counts% *}
	total=${counts#* }
	date=$(git show -s --format=%ad --date=short "$sha")
	short=$(git rev-parse --short "$sha")
	pct=$(awk -v p="$passed" -v t="$total" 'BEGIN { printf "%.1f", t ? p * 100 / t : 0 }')

	if [ -z "$prev" ]; then
		delta=
	else
		delta=$(awk -v a="$passed" -v b="$prev" 'BEGIN { printf "%+d", a - b }')
	fi
	prev=$passed

	if [ -n "$JSON" ]; then
		printf '{"date":"%s","commit":"%s","passed":%s,"total":%s,"percent":%s}\n' \
			"$date" "$short" "$passed" "$total" "$pct"
	else
		printf '%s\t%s\t%s\t%s\t%s%%\t%s\n' \
			"$date" "$short" "$passed" "$total" "$pct" "$delta"
	fi
done
