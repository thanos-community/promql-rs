# Generated / vendored files. GitHub's linguist collapses diffs on
# these so reviewers see the human-written changes first.

# Regenerated from upstream/generated_parser.y + grammar-actions.toml
# + grammar-tokens.toml by `cargo run -p promql-sync -- generate-grammar`.
promql-parser/src/grammar.y linguist-generated=true

# Emitted by scripts/gen-conformance from upstream's parse_test.go.
promql-parser/tests/fixtures/parse_test_corpus.json linguist-generated=true

# Maintained by promql-sync (hash manifest).
promql-parser/upstream/MANIFEST.toml linguist-generated=true

# Verbatim copies from prometheus/prometheus@<pinned sha>. Not our
# source of truth to modify — the `promql-sync pull --target <sha>`
# tool is the only thing that writes here.
promql-parser/upstream/*.go    linguist-vendored=true
promql-parser/upstream/*.y     linguist-vendored=true
